# Copy this file to .env and fill in your values
# NEVER commit .env to version control

DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_ID=1
ACCOUNT_LOGIN_ALERT_EMAILS=False
IMAGE_UPLOAD_MAX_DIMENSION=1600
IMAGE_UPLOAD_QUALITY=82

# Google OAuth / django-allauth
# If you configure Google in Django Admin instead, make sure SITE_ID matches
# the Site attached to the Google SocialApp.
# Authorized redirect URIs for local development:
# http://localhost:8000/accounts/google/login/callback/
# http://127.0.0.1:8000/accounts/google/login/callback/
# Production format:
# https://your-domain.com/accounts/google/login/callback/
SOCIAL_AUTH_GOOGLE_CLIENT_ID=
SOCIAL_AUTH_GOOGLE_CLIENT_SECRET=

# Database
# Leave DATABASE_URL blank to use SQLite in development.
# Set DATABASE_URL for PostgreSQL locally, staging, or production.
# Examples:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/unn_hub_db
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=False

# Legacy PostgreSQL fields used by production.py only when DATABASE_URL is blank.
DB_NAME=unn_hub_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Media (Dev: local, Prod: S3/Cloudinary)
USE_S3=False

# Email / Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@unitrax.com

# AWS S3 (production only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True
